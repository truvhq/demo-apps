# Shared secrets/config used by BOTH pos/ and los/ Django projects and scripts/dev.sh.
# Copy to .env and fill in. Never commit the real .env.

# Fernet key used to encrypt TruvCredentialSet.secret at rest in both apps' SQLite DBs.
# Generate one with: python manage.py generate_truv_key (run from pos/ or los/)
TRUV_CREDENTIAL_ENCRYPTION_KEY=

# Static shared header value used between POS and LOS for internal sync calls
# (X-Internal-Api-Key). Any long random string is fine for local use.
INTERNAL_SYNC_API_KEY=change-me-to-a-long-random-string

# Base URLs each side uses to call the other over the sync API.
POS_BASE_URL=http://localhost:8000
LOS_BASE_URL=http://localhost:8001

# Ports (used by scripts/dev.sh; change here if you need different ports free)
POS_PORT=8000
LOS_PORT=8001
POS_FRONTEND_PORT=5183
LOS_FRONTEND_PORT=5184

# Populated automatically by scripts/dev.sh after starting ngrok (tunnels LOS only).
# You do not need to set this by hand.
NGROK_URL=

# Django secret keys (any random string per project is fine for local use)
POS_DJANGO_SECRET_KEY=dev-pos-secret-change-me
LOS_DJANGO_SECRET_KEY=dev-los-secret-change-me
